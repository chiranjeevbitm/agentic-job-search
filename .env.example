# PostgreSQL connection string (async driver required: postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/jobsearch

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Minimum score (0-100) for a job to count as "suitable" and get a cover letter
SCORE_THRESHOLD=60

# Fallback max jobs per scrape if the request does not specify a count
MAX_JOBS=10
